APP_NAME=TCProject
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- Base de datos
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tcproject
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# --------------------------------------------------------------------- Frontend
# Orígenes permitidos por CORS, separados por coma. Con cookies httpOnly NO se
# puede usar "*".
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
FRONTEND_URL=https://tc.timken.ittec.mx

# -------------------------------------------------------------------------- JWT
# Si se deja vacío se usa APP_KEY. En producción conviene un secreto propio.
JWT_SECRET=
JWT_ISSUER=tcproject-backend
JWT_TTL_MINUTES=15

# Cookie httpOnly que transporta el token
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
# Lax si front y API comparten sitio; None (con HTTPS) si están en dominios distintos.
AUTH_COOKIE_SAME_SITE=Lax

# -------------------------------------------------------------------- Seguridad
# Respaldos usados sólo mientras no exista configuración en base de datos.
SECURITY_MAX_USER_ATTEMPTS=5
SECURITY_MAX_IP_ATTEMPTS=12
SECURITY_SESSION_TIMEOUT_MINUTES=15
SECURITY_ATTEMPT_WINDOW_HOURS=24

# Cuenta inicial creada por SuperAdminSeeder
SUPERADMIN_NAME="Super Administrador"
SUPERADMIN_EMAIL=superadmin@local.test
# Obligatoria: sin ella el seeder no crea la cuenta inicial
SUPERADMIN_PASSWORD=

# --------------------------------------------------------------- Tipo de cambio
# Token de la SIE API de Banxico (https://www.banxico.org.mx/SieAPIRest)
BANXICO_TOKEN=
BANXICO_FIX_SERIES=SF43718
BANXICO_LOOKBACK_DAYS=7
# Decimales del resultado publicación × factor
EXCHANGE_RATE_SCALE=4
# Días inhábiles fijos además de sábados y domingos, separados por coma (YYYY-MM-DD)
EXCHANGE_RATE_HOLIDAYS=
# En un dia feriado no hay publicacion aplicable: se conserva el TC del dia habil anterior.
EXCHANGE_HOLIDAY_CARRY_OVER=true

# ------------------------------------------------------------------- Feriados
# Años hacia adelante que se pueden capturar (además del año en curso)
HOLIDAYS_YEARS_AHEAD=1
# Recordatorio de captura del año siguiente
HOLIDAYS_REMINDER_ENABLED=true
HOLIDAYS_REMINDER_START=11-15
HOLIDAYS_REMINDER_HOUR=07:00

# ----------------------------------------------------------------------- Correo
# log = el correo se escribe en storage/logs; sendgrid = envío real
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tcproject.local"
MAIL_FROM_NAME="${APP_NAME}"
SENDGRID_API_KEY=

# Valores iniciales de emailconfig (normal | override | disabled)
EMAIL_MODE=normal
EMAIL_OVERRIDE_ADDRESS=
MAIL_SUPPORT_ADDRESS=soporte@tcproject.local
